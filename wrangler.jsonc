{
  "name": "english-savant-ai",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SPEECH_SERVICE",
        "class_name": "SpeechService"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-speech",
      "new_sqlite_classes": [
        "SpeechService"
      ]
    }
  ]
}
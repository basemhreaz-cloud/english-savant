    {
      "id": "k2u2-song",
      "kind": "lines",
      "title_ar": "أغنية الهدوم",
      "instr": "ar2-i-song",
      "whole": "en-song",
      "lines": [
        {
          "text": "I wear my cap when I play in the sun,"
        },
        {
          "text": "a T-shirt and shorts, that's so much fun!"
        },
        {
          "text": "pants for when the day is cool,"
        },
        {
          "text": "socks and shoes - now I'm ready for school!"
        }
      ]
    },
    {
      "id": "k2u2-values",
      "kind": "lines",
      "title_ar": "نتكلم عن هدومنا",
      "instr": "ar2-i-values",
      "lines": [
        {
          "text": "Take care of your belongings.",
          "audio": "en-v-care"
        },
        {
          "text": "Be clean and tidy.",
          "audio": "en-v-tidy"
        },
        {
          "text": "Celebrate differences. It's okay to wear different things.",
          "audio": "en-v-diff"
        }
      ]
    },
    {
      "id": "k2u2-story",
      "kind": "story",
      "title_ar": "قصة الهدوم مع دينا ومازن",
      "help": "بص على كل مشهد. الشرح بالمصري مكتوب الأول، وزر الصوت بيشغّل الجملة بالإنجليزي بس. اسمعوا ومثّلوا سوا مع شخص كبير، من غير تسجيل للصوت أو درجات.",
      "panels": [
        {
          "image": "u2/u2-story-1.webp",
          "alt": "دينا لابسة فستان ومازن لابس تيشيرت أحمر",
          "lines": [
            {
              "speaker": "Dina",
              "speaker_ar": "دينا",
              "text": "Hi, Mazen. I like your red T-shirt.",
              "meaning_ar": "أهلًا يا مازن. التيشيرت الأحمر بتاعك عاجبني.",
              "audio": "u2-en-st-1a"
            },
            {
              "speaker": "Mazen",
              "speaker_ar": "مازن",
              "text": "Thank you, Dina! I like your dress.",
              "meaning_ar": "شكرًا يا دينا! الفستان بتاعك عاجبني.",
              "audio": "u2-en-st-1b"
            }
          ]
        },
        {
          "image": "u2/u2-story-2.webp",
          "alt": "دينا ومازن في محل الهدوم ومعاهم أربع شورتات",
          "lines": [
            {
              "speaker": "Dina",
              "speaker_ar": "دينا",
              "text": "Let's buy clothes!",
              "meaning_ar": "يلا نشتري هدوم!",
              "audio": "u2-en-st-2a"
            },
            {
              "speaker": "Mazen",
              "speaker_ar": "مازن",
              "text": "I want four pairs of shorts.",
              "meaning_ar": "أنا عايز أربع شورتات.",
              "audio": "u2-en-st-2b"
            }
          ]
        },
        {
          "image": "u2/u2-story-3.webp",
          "alt": "تلات جيبات وخمس كابات في محل الهدوم",
          "lines": [
            {
              "speaker": "Dina",
              "speaker_ar": "دينا",
              "text": "I want three skirts.",
              "meaning_ar": "أنا عايزة تلات جيبات.",
              "audio": "u2-en-st-3a"
            },
            {
              "speaker": "Mazen",
              "speaker_ar": "مازن",
              "text": "Let's get five caps too!",
              "meaning_ar": "وناخد خمس كابات كمان!",
              "audio": "u2-en-st-3b"
            }
          ]
        },
        {
          "image": "u2/u2-story-4.webp",
          "alt": "دينا ومازن شايلين شنط التسوق",
          "lines": [
            {
              "speaker": "Dina",
              "speaker_ar": "دينا",
              "text": "Yay! Let's count! One, two, three, four, five!",
              "meaning_ar": "يا سلام! يلا نعد: واحد، اتنين، تلاتة، أربعة، خمسة!",
              "audio": "u2-en-st-4a"
            },
            {
              "speaker": "Mazen",
              "speaker_ar": "مازن",
              "text": "Yay! Shopping is fun!",
              "meaning_ar": "يا سلام! التسوق ممتع!",
              "audio": "u2-en-st-4b"
            }
          ]
        }
      ],
      "adaptation_note": "الرسوم تعليمية أصلية، مش صور الكتاب. بداية آخر مشهد في التسجيل Yay بدل Yes في الكتاب.",
      "instr": "ar-story-act"
    }
  ],
  "held": [
    "رسمة الألوان للفستان"
  ]

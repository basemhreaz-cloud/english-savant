    {
      "id": "k2pre-role",
      "kind": "lines",
      "title_ar": "نمثّل مع شخص كبير",
      "help": "اسمعوا الجمل بالإنجليزي ومثّلوها مع شخص كبير. Nour اسم مثال في الكتاب، وبعدها الطفل يقول اسمه هو. مفيش اسم أو صوت بيتسجّل. بنسمع معنى الكلمات من صورها في النشاط الأول.",
      "lines": [
        {
          "text": "Hello.",
          "meaning_ar": "أهلًا.",
          "audio": "k1-en-w-hello"
        },
        {
          "text": "Good morning.",
          "meaning_ar": "صباح الخير.",
          "audio": "k1-en-w-good-morning"
        },
        {
          "text": "What is your name?",
          "meaning_ar": "اسمك إيه؟",
          "audio": "close-en-name-question"
        },
        {
          "text": "My name is Nour.",
          "meaning_ar": "اسمي نور. ده اسم مثال، وبعده قول اسمك أنت.",
          "audio": "close-en-name-nour"
        },
        {
          "text": "I'm a boy.",
          "meaning_ar": "أنا ولد.",
          "audio": "close-en-boy"
        },
        {
          "text": "I'm a girl.",
          "meaning_ar": "أنا بنت.",
          "audio": "close-en-girl"
        },
        {
          "text": "We are friends.",
          "meaning_ar": "إحنا أصحاب.",
          "audio": "close-en-friends"
        },
        {
          "text": "Goodbye.",
          "meaning_ar": "مع السلامة.",
          "audio": "k1-en-w-goodbye"
        }
      ]
    },
